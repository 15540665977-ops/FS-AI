# Public hostname already pointing to this server's public IPv4/IPv6 address.
DOMAIN=spectra.example.com
# Email used only by Let's Encrypt for certificate notices.
ACME_EMAIL=ops@example.com

# Required for AI analysis.
ANTHROPIC_API_KEY=
# Optional web-research enhancement.
TAVILY_API_KEY=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# For a GitHub Pages frontend on a different site, use `none`; otherwise use `lax`.
SESSION_COOKIE_SAME_SITE=none

# Created exactly once on first start, while no users exist.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Default: 20 MiB per individual uploaded file, 10 files per request.
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_FILES=10
