# Required for AI analysis. Do not commit a real API key.
ANTHROPIC_API_KEY=

# Optional. Enables supplemental online technical-literature searches.
TAVILY_API_KEY=

# Required before public deployment. Generate a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=

# Bootstrap administrator: created only when the users table is empty.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Local development defaults. Production Docker Compose overrides these values.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
REQUIRE_SECURE_CONFIG=false
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_FILES=10

# Optional. Defaults to backend/spectral_analysis.db, independent of the launch directory.
# SPECTRAL_DATABASE_URL=sqlite:///D:/spectral_analysis_system/backend/spectral_analysis.db

# Optional. Comma-separated browser origins for direct API access.
# This is unnecessary when the Vite frontend proxy is used on the same host.
# CORS_ALLOW_ORIGINS=http://192.168.1.100:5173,http://localhost:5173
